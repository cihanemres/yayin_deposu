# Bu dosyayi ".env" olarak kopyalayin ve anahtarlari doldurun.
# .env dosyasini ASLA paylasmayin, e-postayla gondermeyin, commit etmeyin.
# Anahtari olmayan araclar otomatik atlanir — hepsini birden doldurmak zorunda degilsiniz.

# Onerilen sira icin YOL_HARITASI.md'ye bakin. Ozet: Pangram ve Copyleaks
# ucretsiz denenebiliyor VE Turkce'yi acikca destekleyen iki arac — onlarla baslayin.

# --- Pangram --- https://www.pangram.com/apikey   [ONCE BUNU AL]
# Ucretsiz: 4 kredi/gun. Akademik arastirma kredisi basvurusu var.
# Turkce: VAR (24 dil listesinde adiyla, %99,90 iddia)
PANGRAM_API_KEY=

# --- Copyleaks --- https://api.copyleaks.com/dashboard   [SONRA BUNU]
# HEM e-posta HEM anahtar gerekir. sandbox=True ucretsiz, kredi harcamaz.
# Turkce: VAR ('tr' desteklenen 30 dil listesinde)
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=

# --- ZeroGPT --- https://zerogpt.com  (bakiye yukle + IP whitelist gerekir)
# Ucretsiz katman YOK. Fiyat: curl https://api.zerogpt.com/api/dashboard/getPackages
# Turkce: SUPHELI (sadece genel pazarlama iddiasi)
ZEROGPT_API_KEY=

# --- Sapling --- https://sapling.ai/api_settings
# Ucretsiz deneme: 50k karakter/24 saat (korpus ~350k -> birkac gune bolun)
# Turkce: YOK — dokumani "only available for English" diyor. Yine de dahil:
# desteklemedigi hâlde skor uretmesi makalenin bulgusu.
SAPLING_API_KEY=

# --- GPTZero --- https://app.gptzero.me/app/api
# Ucretsiz API katmani yok. Turkce: YOK (API dokumani FR/ES diyor).
# Desteklenmeyen dilde SESSIZCE Ingilizce modeline duser — bulgu olarak degerli.
GPTZERO_API_KEY=

# --- Originality.ai --- https://app.originality.ai/home/api-token-dashboard
# ! API yalnizca Enterprise katmaninda (~$136,58/ay). En sona birakin.
# ! Otomatik bakiye yukleme VARSAYILAN ACIK — kapatin:
#   app.originality.ai/home/account#topup
# Turkce: VAR ama aiModelVersion='multilang' sart (kodda gonderiliyor)
ORIGINALITY_API_KEY=
